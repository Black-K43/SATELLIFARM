# Copy this file to ".env" and fill in your keys. NEVER upload .env to GitHub.

# OpenET (water: ETo, actual field ET, gridMET rain) — free account at https://etdata.org -> profile -> API key
OPENET_API_KEY=

# Google Earth Engine cloud project (GPM-IMERG, SMAP, Sentinel-2, SRTM)
# 1) register a non-commercial project at https://console.cloud.google.com/earth-engine
# 2) run once on your PC:  earthengine authenticate
EE_PROJECT=

# USDA NASS QuickStats (yields and prices) — free key by email at https://quickstats.nass.usda.gov/api
NASS_API_KEY=

# USDA AMS MyMarketNews (optional, daily cash prices) — https://mymarketnews.ams.usda.gov -> My Profile -> API key
# Also fill AMS_REPORTES in fuentes.py with the report ids you want.
AMS_API_KEY=

# NASA Earthdata login (ECOSTRESS surface temperature) — free account at https://urs.earthdata.nasa.gov
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
